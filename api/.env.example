# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env nunca vai para o git.

# Banco de desenvolvimento
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/academia_dev"

# Banco usado só pelos testes (é apagado a cada execução)
DATABASE_URL_TEST="postgresql://USUARIO:SENHA@localhost:5432/academia_test"

# Texto longo e aleatório, usado para assinar os tokens de login
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Porta da API
PORT=3333

# Endereço do front que pode chamar a API
CORS_ORIGIN="http://localhost:5173"

# Senha dos três usuários de demonstração criados pelo seed
SEED_DEMO_PASSWORD="troque-por-uma-senha-de-demonstracao"
