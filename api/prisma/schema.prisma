generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  plan          Plan?     @relation(fields: [planId], references: [id])
  planId        String?
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())

  // Aulas que este usuário ministra (só faz sentido para instrutores)
  classes ClassTemplate[]

  // Fichas de treino que este aluno montou
  workouts Workout[]
}

model Plan {
  id             String @id @default(uuid())
  name           String @unique
  priceCents     Int
  durationMonths Int
  description    String

  users User[]
}

model Modality {
  id          String @id @default(uuid())
  name        String @unique
  description String

  classes ClassTemplate[]
}

/// Uma aula recorrente da grade semanal (ex.: Spinning, toda segunda às 19h).
model ClassTemplate {
  id              String   @id @default(uuid())
  modality        Modality @relation(fields: [modalityId], references: [id])
  modalityId      String
  instructor      User     @relation(fields: [instructorId], references: [id])
  instructorId    String
  /// 0 = domingo ... 6 = sábado
  weekday         Int
  /// Horário de início no formato "HH:MM"
  startTime       String
  durationMinutes Int
  capacity        Int

  @@unique([modalityId, weekday, startTime])
}

/// Exercício do catálogo (textos em português; fotos em web/public/exercicios).
model Exercise {
  id            String   @id @default(uuid())
  /// Identificador legível e estável, usado na URL e no nome da pasta de fotos.
  slug          String   @unique
  name          String
  /// peito, costas, ombros, biceps, triceps, pernas, gluteos, abdomen
  muscleGroup   String
  equipment     String
  level         String
  primaryMuscle String
  description   String
  steps         String[]
  /// Caminhos das 2 fotos (posição inicial e final), alternadas como animação.
  images        String[]

  items WorkoutItem[]

  @@index([muscleGroup])
}

/// Uma ficha montada pelo aluno (Treino A, Treino B...).
model Workout {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  createdAt DateTime @default(now())

  items WorkoutItem[]

  @@index([userId])
}

/// Um exercício dentro de uma ficha, com séries e repetições.
model WorkoutItem {
  id         String   @id @default(uuid())
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId  String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId String
  /// Ordem dentro da ficha, começando em 0.
  position   Int
  sets       Int
  reps       Int

  @@index([workoutId])
}
